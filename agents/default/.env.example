# Agent runtime env. Copy to one Agent home as `.env`.
#
# The platform materialize step also writes this file shape from the current
# `agent.yaml` references and preserves operator-filled values. Never commit real
# secrets.

# Model targets from agents/default/agent.yaml.example.
FLEETENT_MODEL_PRIMARY_API_KEY=
FLEETENT_MODEL_FAST_API_KEY=
FLEETENT_MODEL_EMBEDDING_API_KEY=
FLEETENT_MODEL_RERANK_API_KEY=

# Agent-level embedding service.
FLEETENT_EMBED_API_KEY=
FLEETENT_EMBED_DIMENSIONS=
FLEETENT_EMBED_ENDPOINT=
FLEETENT_EMBED_MODEL=

# Agent-level rerank service.
FLEETENT_RERANK_API_KEY=
FLEETENT_RERANK_ENDPOINT=
FLEETENT_RERANK_MODEL=

# Agent MCP servers.
ACME_DOCS_MCP_TOKEN=
# Secrets consumed by stdio MCP subprocesses (passed via the server's env: block).
BILLING_DB_DSN=

# Agent IM connectors.
SUPPORT_SLACK_BOT=
SUPPORT_SLACK_APP=
SUPPORT_TG_BOT=
