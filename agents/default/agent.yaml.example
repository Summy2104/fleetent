# Self-contained agent definition for a deployed single agent.
#
# Layout: this file is materialized to one Agent runtime home:
#   FLEETENT_HOME/agents/<agent-id>/agent.yaml
# alongside that Agent's .env and data/.
# The deployed agent runtime reads ONLY this file + .env; data is local under
# FLEETENT_HOME/agents/<agent-id>/data/. Secrets are NEVER inlined — reference them
# by env-var name.
# The Agent `.env` is generated/refreshed from these references by platform
# materialize (or copied from the console required-env panel), not maintained as a
# static global secret inventory.
# (This template ends in `.example`; install.sh copies it to
#  FLEETENT_HOME/agents/default/agent.yaml for the default local Agent.)
#
# Single-agent mode: this agent is the sole, forced-default agent, so there is no
# routing table and `bindings.default` does not apply. `bindings.channels/users`
# act only as ingress filters for this one agent.
#
# Migrating from an older global config (config consolidation): every agent-runtime
# knob that used to live in `config/settings.yaml` now lives HERE in agent.yaml —
#   • intelligence: vector_store / embedding / rerank / knowledge / long_term_ctx / mcp
#   • governance:   context_* / agent_budget_* / agent_max_* / permission_gate_* /
#                   tool_default_timeout_seconds / provider_* (see "runtime governance" below)
#   • deployment:   microsandbox_url / session_* / image_gen_* / vision_* / disabled_skills /
#                   observability / diagnostics / scheduling / webhooks
#   • default agent: the old `default_agent_name` is now `bindings.default: true`
#   • IM tokens:     the old slack_/telegram_ tokens are now `connectors.*` `*_env` refs (Slack)
#                    or owner-level env vars (Telegram); never inline
# The platform `config/settings.yaml` keeps only `database_url` / `log_format` / `observability`.

name: support-bot                  # required; the agent's name (any value in single-agent mode)
version: 3                         # required
tenant_id: acme-corp               # optional, default "default"
team_id: cs-team-01                # optional, default null

# ── runtime definition ──
system_prompt: |
  你是 Acme 公司的客户支持助手 support-bot。
  - 用中文回答用户的产品和账单问题
  - 不确定的信息先用 search_docs 工具检索知识库再作答
  - 涉及退款、账户删除等敏感操作必须走人工审批
  - 保持礼貌、简洁，单次回复不超过 5 句话
models:
  targets:
    - id: primary
      provider: anthropic
      protocol: openai_chat
      base_url: https://api.anthropic.com/v1/
      model: claude-opus-4-8
      api_key_env: FLEETENT_MODEL_PRIMARY_API_KEY
      max_tokens: 4096
    - id: fast
      provider: anthropic
      protocol: openai_chat
      base_url: https://api.anthropic.com/v1/
      model: claude-haiku-4-5-20251001
      api_key_env: FLEETENT_MODEL_FAST_API_KEY
      max_tokens: 1024
      params:
        temperature: 0
    - id: embedding
      provider: local
      protocol: http_embedding
      endpoint: http://localhost:9002/v1/embeddings
      model: bge-m3
      api_key_env: FLEETENT_MODEL_EMBEDDING_API_KEY
      params:
        dimensions: 64
    - id: rerank
      provider: local
      protocol: http_rerank
      endpoint: http://localhost:9003/v1/rerank
      model: bge-reranker
      api_key_env: FLEETENT_MODEL_RERANK_API_KEY
    - id: image
      provider: local
      protocol: openai_image_generation
      endpoint: http://localhost:9004/v1/images/generations
      model: flux-schnell
  routes:
    default:
      - target: primary
      - target: fast
    memory_extraction:
      - target: fast
        max_tokens: 1024
        params:
          temperature: 0
    vision:
      - target: primary
    embedding:
      - target: embedding
    rerank:
      - target: rerank
    image_generation:
      - target: image
memory_namespace: support-bot      # default ""
skills_dir: skills                 # null = global default skills dir
allowed_skills:                    # empty = no narrowing (all enabled skills visible)
  - jira
  - slack-daily-jira

# ── tools / capabilities ──
allowed_tools:                     # fnmatch patterns; MCP tools are "<server>__<tool>"
  - "search_*"
  - "read_skill"
  - "read_file"
  - "docs__*"
  - "jira__*"
plugins:
  - acme-docs
  - billing
features:
  code_execution: true             # expose the run_code sandbox tool
  sandbox_env:
    TZ: Asia/Shanghai
    LANG: zh_CN.UTF-8

# ── intelligence configuration (non-secret; credentials via .env references) ──
vector_store:
  backend: sqlite                  # memory | sqlite; default "memory"
  database_url: sqlite:///data/vector_store.db

embedding:
  backend: http                    # deterministic | http; default "deterministic"
  dimensions: 64
  dimensions_env: FLEETENT_EMBED_DIMENSIONS   # overrides `dimensions` at runtime
  endpoint: ""
  endpoint_env: FLEETENT_EMBED_ENDPOINT
  model: ""
  model_env: FLEETENT_EMBED_MODEL
  api_key_env: FLEETENT_EMBED_API_KEY
  timeout_seconds: 10.0

rerank:
  backend: http                    # disabled | http; default "disabled"
  endpoint: ""
  endpoint_env: FLEETENT_RERANK_ENDPOINT
  model: ""
  model_env: FLEETENT_RERANK_MODEL
  api_key_env: FLEETENT_RERANK_API_KEY
  timeout_seconds: 10.0

knowledge:
  enabled: true
  bindings:
    - tenant_id: pilot-tenant
      kb_id: pilot-kb
      default: true
      permissions:
        search: true
  retrieval_policy:
    mode: hybrid                   # vector | keyword | hybrid; default "hybrid"
    top_k: 10
    rerank: true
    embedding_route: embedding
    rerank_route: rerank

long_term_ctx:
  max_tokens: 2048
  memory_max_tokens: 1024
  knowledge_max_tokens: 1024
  memory_top_k: 10
  knowledge_top_k: 10
  conflict_preference: auto        # auto | memory | knowledge; default "auto"

# ── MCP servers (inline; secrets via env reference only) ──
mcp_servers:
  - id: docs
    transport: http
    url: https://docs.acme.internal/mcp
    auth_type: bearer
    api_key_env: ACME_DOCS_MCP_TOKEN   # env-var NAME, never the token value
  - id: billing
    transport: stdio
    command: /usr/local/bin/billing-mcp
    args:
      - "--mode"
      - "readonly"
    env:
      BILLING_DB_DSN_ENV: BILLING_DB_DSN

# ── connectors (per-agent IM ingress; tokens via env reference only) ──
connectors:
  slack:
    bot_token_env: SUPPORT_SLACK_BOT   # env-var NAME (xoxb- token lives in .env)
    app_token_env: SUPPORT_SLACK_APP   # env-var NAME (xapp- Socket Mode token)
    channels:                          # optional filter; empty = respond everywhere
      - C0123ABCD
      - C0456EFGH

# ── bindings (ingress filters; the deployed single agent is always default) ──
bindings:
  channels:
    - "slack:C0123ABCD"
    - "telegram:-1001234567890"
  users:
    - "u_alice"
    - "u_bob"

# ── per-agent runtime governance (resolved from this agent.yaml; config consolidation).
#    All values below equal the current defaults; omit any you don't override. ──

# context window management
context_max_tokens: 200000         # hard ceiling for the context window
context_compress_threshold: 0.8   # trigger compression when token_count / context_max_tokens exceeds this
context_tmax_ratio: 0.8           # Tmax = context_max_tokens * ratio; used by compressor as target ceiling
context_tretained_ratio: 0.6      # Tretained = context_max_tokens * ratio; tokens to retain after compression
context_keep_recent: 10           # number of most-recent messages always kept verbatim
compression_initial_intent_max: 2 # max leading user messages preserved whole during compression
context_flap_window: 3            # suppress re-compression within this many turns after one fires
context_min_savings_ratio: 0.10   # skip compression if projected savings < this fraction
context_min_interval_turns: 1     # minimum turns between consecutive compressions

# loop detection / guardrails
agent_loop_repeat_threshold: 3    # identical tool-call sequences before loop is declared
guardrail_repeat_threshold: 3     # identical assistant utterances before guardrail fires
loop_detect_ignore_arg_keys: []   # argument keys excluded from loop-detection fingerprint

# turn / token limits
agent_max_turns: 50               # max tool-use turns per request; -1 = unlimited
agent_max_consecutive_failures: 3 # consecutive tool errors before aborting
agent_max_tokens: -1              # max output tokens per LLM call; -1 = model default
tool_default_timeout_seconds: 30.0
sub_agent_timeout_seconds: 300
agent_tool_parallel_max: 8        # max concurrent tool calls per turn

# run-time input steering: how a new IM message is handled while a run is in flight
steering_mode: steer              # steer (inject into the running task) | queue | interrupt
steering_max_pending: 8           # max queued steered messages per session

# layered budget — session / user / agent dims (-1 = unlimited)
agent_budget_session_turns: -1
agent_budget_session_tokens: -1
agent_budget_user_turns: -1
agent_budget_user_tokens: -1
agent_budget_user_window: weekly   # rolling window: daily | weekly | monthly
agent_budget_agent_turns: -1
agent_budget_agent_tokens: -1
agent_budget_agent_window: weekly

# grace-call budget (reserved for the final summary call after budget is nearly exhausted)
agent_grace_call_token_ratio: 0.05  # fraction of session budget reserved for grace call
agent_grace_call_min_tokens: 512    # minimum tokens guaranteed for grace call regardless of ratio

# permission gate timeouts (seconds; 0 = deny immediately)
permission_gate_medium_timeout_seconds: 300
permission_gate_high_timeout_seconds: 3600

# provider circuit breaker
provider_failure_threshold: 3     # consecutive failures before a provider is marked unhealthy
provider_cooldown_seconds: 60     # seconds a tripped provider stays in cooldown

# ── per-agent deployment / process knobs ──
microsandbox_url: http://host.docker.internal:7777
log_format: console               # console | json
session_ttl_days: 30
session_max_total_mb: 1024        # total size cap for all sessions on disk (MB)
session_max_count: 10000          # max number of sessions retained
session_cleanup_interval_seconds: 3600.0
disabled_skills: []

# image generation / vision (self-hosted; empty url = disabled)
image_gen_url: ""
image_gen_model: default          # model name passed to the image generation endpoint
vision_url: ""
vision_model: default             # model name passed to the vision endpoint

# ── feature toggles (per-capability on/off + tuning) ──
mcp:
  enabled: true                   # set false to disable all MCP tool calls for this agent

scheduling:
  enabled: true                   # set false to disable APScheduler cron tasks for this agent
  default_timezone: "UTC"

webhooks:
  enabled: true                   # set false to reject all inbound webhook calls
  max_body_bytes: 1048576         # max webhook request body size (bytes); default 1 MiB

# ── observability ──
observability:
  logging:
    console_level: info           # log level for stderr: debug | info | warning | error
    file_level: debug             # log level for the rotating file sink
    directory: data/logs          # log file directory (relative to agent home)
    json_file: true               # write structured JSON log file in addition to console

diagnostics:
  export_dir: data/diagnostics    # directory for diagnostic export bundles
  retention:
    enabled: false                # set true to auto-purge old diagnostic data
    logs_days: null               # null = keep forever; integer = days to retain log files
    traces_days: null             # days to retain agent run traces
    diagnostic_exports_days: null # days to retain diagnostic export bundles

# NOTE: agent_budget_global_* and database_url are intentionally NOT accepted here.
# The database location is derived from the agent home (<home>/data/fleetent.db).

# ── access control (per-agent IM authorization; closed by default) ──
# Default is closed: with no rules the agent grants no implicit access and requires
# approval. allow_channels empty = allow every channel the agent is bound to.
access:
  allow_channels:
    - "slack:C0123ABCD"
  allow_users:
    - "u_alice"
  require_approval: true
