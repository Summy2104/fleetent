# Platform control-plane config.
#
# Default deployment keeps knowledge / memory / vector / worker capabilities embedded
# in the Platform service. Standalone Knowledge Service templates are deferred until
# that deployment mode is supported.

knowledge:
  mode: embedded
  knowledge_bases:
    - id: pilot-kb
      tenant_id: pilot-tenant
      name: Pilot Knowledge Base
      indexing:
        chunk_size: 1000
        chunk_overlap: 200
        parser_profile: default
        vector_store: default
      sync:
        mode: manual
        schedule: ""
      sources:
        - id: pilot-drive
          type: google_drive
          enabled: false
          folder_id: ""
          recursive: true
          access_token_env: FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN
          refresh_token_env: FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN
          client_id_env: FLEETENT_GOOGLE_DRIVE_CLIENT_ID
          client_secret_env: FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET
          token_uri_env: FLEETENT_GOOGLE_DRIVE_TOKEN_URI
        - id: pilot-confluence
          type: confluence
          enabled: false
          base_url: ""
          username_env: FLEETENT_CONFLUENCE_USERNAME
          scope_type: space
          space_key: ""
          include_children: true
          api_token_env: FLEETENT_CONFLUENCE_TOKEN
  remote:
    endpoint: ""
    auth_token_env: ""
