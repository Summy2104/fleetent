# Platform control-plane config.
#
# Default deployment keeps knowledge / memory / vector / worker capabilities embedded
# in the Platform service. Standalone Knowledge Service templates are deferred until
# that deployment mode is supported.

log_format: console

observability:
  logging:
    console_level: info
    file_level: debug
    directory: data/logs
    json_file: true

oidc:
  enabled: false
  issuer: https://idp.example.com/realms/acme
  client_id: fleetent-web
  client_secret_env: FLEETENT_OIDC_CLIENT_SECRET
  redirect_uri: https://fleetent.example.com/admin/oidc/callback
  # Empty falls back to the UI default "Sign in with SSO"; set a deployment label
  # such as "Sign in with Google" when the IdP should be named on the login button.
  button_label: ""
  # Empty means no OIDC email-domain restriction. Entries are exact, case-insensitive
  # email domains; subdomains must be listed explicitly. This can be used together
  # with IdP-side domain restrictions.
  allowed_email_domains:
    - acme.com
    - eu.acme.com
  scopes:
    - openid
    - email
  tenant: default

# Sandbox config is per-agent now — not in this shared platform.yaml.
#   - Code-execution enablement: each agent's agent.yaml `features.code_execution`
#     (unset/true = on, false = off), gated by runtime backend availability (no Docker
#     → off). There is no global tri-state `sandbox.mode` (per-agent-sandbox-enablement).
#   - Resources / hardening / lifecycle / skills-mount: each agent's agent.yaml
#     `sandbox.resources` / `sandbox.workspace_scope` / `sandbox.idle_hours` /
#     `sandbox.skill_mount` (per-agent-sandbox-resources).
# Only `sandbox.backend` (optional machine default for backend selection, agent.yaml
# overrides; docker when absent) may still appear here. See
# docs/migration/per-agent-sandbox-config.md.

scheduling:
  enabled: true
  default_timezone: UTC

webhooks:
  enabled: true
  max_body_bytes: 1048576

kb_serve:
  # Central multi-tenant kb-serve URL used by /admin/kb data-plane operations
  # AND materialized into bound agents' http knowledge provider — so it must be
  # reachable from agents too, not only from the platform. In docker-compose use
  # the service DNS name (http://kb-serve:8768); 127.0.0.1 is single-host only.
  url: http://127.0.0.1:8768
  service_key_ref: env:FLEETENT_PLATFORM_KB_SERVICE_KEY

knowledge:
  mode: embedded
  knowledge_bases:
    - id: pilot-kb
      tenant_id: pilot-tenant
      name: Pilot Knowledge Base
      indexing:
        chunk_size: 1000
        chunk_overlap: 200
        parser_profile: default
        vector_store: default
      sync:
        mode: manual
        schedule: ""
      sources:
        - id: pilot-drive
          type: google_drive
          enabled: false
          folder_id: example-folder-id
          recursive: true
          access_token_env: FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN
          refresh_token_env: FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN
          client_id_env: FLEETENT_GOOGLE_DRIVE_CLIENT_ID
          client_secret_env: FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET
          token_uri_env: FLEETENT_GOOGLE_DRIVE_TOKEN_URI
        - id: pilot-confluence
          type: confluence
          enabled: false
          base_url: https://example.atlassian.net/wiki
          username_env: FLEETENT_CONFLUENCE_USERNAME
          scope_type: space
          space_key: EXAMPLE
          include_children: true
          api_token_env: FLEETENT_CONFLUENCE_TOKEN
  remote:
    endpoint: ""
    auth_token_env: ""
