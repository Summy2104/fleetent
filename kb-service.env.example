# Shared Bearer secret for kb-serve clients (platform admin proxy, agent HTTP
# provider). Must match what the platform resolves via KB_SERVE__SERVICE_KEY_REF.
FLEETENT_KB_SERVICE_KEY=replace-me

FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN=replace-me
FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN=replace-me
FLEETENT_GOOGLE_DRIVE_CLIENT_ID=replace-me
FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET=replace-me
FLEETENT_GOOGLE_DRIVE_TOKEN_URI=https://oauth2.googleapis.com/token

FLEETENT_CONFLUENCE_USERNAME=bot@example.com
FLEETENT_CONFLUENCE_TOKEN=replace-me
