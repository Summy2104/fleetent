# Copy this file to $FLEETENT_HOME/node/.env on the agent host running `fleetent node start`.
# Set file permissions to 0600 because it contains the node service key.
# FLEETENT_HOME must be provided by the process environment; do not set it in this file.
# Get FLEETENT_NODE_SERVICE_KEY from `fleetent platform node register` or `scripts/dev_node_provision.py`.

FLEETENT_NODE_PLATFORM_URL=http://127.0.0.1:8765
FLEETENT_NODE_ID=
FLEETENT_NODE_SERVICE_KEY=
FLEETENT_NODE_INTERVAL_SECONDS=10
# Address this host is reachable at FROM the platform (IP or hostname), reported
# to the platform in the status heartbeat. Set this so platform→node chat/WS
# forwarding does not depend on external DNS resolving {node_id}.internal.
# Single-machine pilot: 127.0.0.1. Leave empty to fall back to the override / .internal convention.
# Platform forward-addressing priority: reported host (this var) -> FLEETENT_FORWARDER_HOST_OVERRIDE -> {node_id}.internal
FLEETENT_NODE_ADVERTISE_HOST=
# Platform-side global fallback when no node has reported an address (applies to ALL nodes).
FLEETENT_FORWARDER_HOST_OVERRIDE=
