# Copy this file to $FLEETENT_HOME/node/.env on the agent host running `fleetent node start`.
# Set file permissions to 0600 because it contains the node service key.
# FLEETENT_HOME must be provided by the process environment; do not set it in this file.
# Get FLEETENT_NODE_SERVICE_KEY from `fleetent admin node register`.

FLEETENT_NODE_PLATFORM_URL=http://127.0.0.1:8765
FLEETENT_NODE_ID=node-example
FLEETENT_NODE_SERVICE_KEY=ma-your-node-service-key
FLEETENT_NODE_INTERVAL_SECONDS=10
