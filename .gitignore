# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# uv
.python-version-cache/

# Runtime data — keep repo clean and avoid leaking conversations
data/*.jsonl
data/*.db
data/logs/
data/users/
data/sessions/
data/
reports/
.tmp/

# Env
.env
.env.local
.env.production
secrets/

# Worktrees
.worktrees/
.claude/worktrees/

# Browser self-test artifacts (Playwright MCP)
.playwright-mcp/

# Config — *.example / *.yaml.example templates are committed; real configs are not.
# `.env` (above) ignores root Platform env and nested Agent env files.
platform.yaml
agent.yaml
config/*.yaml
config/agent/*.yaml
config/platform/*.yaml
config/agents/*/agent.yaml
agents/*/agent.yaml
agents/*/.env
agents/*/data/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

.coverage

# Claude Code runtime locks
.claude/*.lock
