# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# uv
.python-version-cache/

# Runtime data — keep repo clean and avoid leaking conversations
data/*.jsonl
data/*.db
data/logs/
data/users/
data/sessions/
data/
reports/
.tmp/

# Env
.env
.env.local
.env.production
secrets/

# Dev master key (generated by scripts/dev_secret_key.py, never commit)
.dev_secret_key

# Worktrees
.worktrees/
.claude/worktrees/

# Browser self-test artifacts (Playwright MCP)
.playwright-mcp/

# Config — *.example / *.yaml.example templates are committed; real configs are not.
# `.env` (above) ignores root Platform env and nested Agent env files.
platform.yaml
agent.yaml
config/*.env
config/*.yaml
config/agent/*.yaml
config/platform/*.yaml
config/agents/*/agent.yaml
agents/*/agent.yaml
agents/*/.env
agents/*/data/
agents/*/skills/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

.coverage

# Claude Code runtime locks
.claude/*.lock
docs/local/

# Generated architecture diagrams
docs/architecture/*.html

# local dev deployment (FLEETENT_HOME)
.fleetent-dev/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/*.tsbuildinfo
