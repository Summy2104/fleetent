service:
  service_key_ref: env:FLEETENT_KB_SERVICE_KEY
  # Bind address. 127.0.0.1 suits same-host dev; in containers (docker-compose
  # kb-serve) it must be 0.0.0.0 or the platform/agent containers cannot reach
  # the service. Note: with --config, the CLI --host flag is ignored — this
  # field is authoritative.
  host: 127.0.0.1
  port: 8768
  # Optional per-file upload cap for POST /kb/{kb_id}/documents and
  # platform /admin/kb/{kb_id}/documents proxy uploads. Default: 50 MiB.
  max_upload_bytes: 52428800

retrieval:
  default_mode: hybrid
  top_k: 10

embedding:
  endpoint: http://127.0.0.1:11434/v1/embeddings
  model: bge-small
  dimensions: 384
  api_key_env: FLEETENT_KB_EMBEDDING_API_KEY

extraction:
  enabled: false
  endpoint: http://127.0.0.1:11434/v1/
  model: qwen3:8b
  api_key_env: FLEETENT_KB_EXTRACTION_API_KEY

rerank:
  backend: disabled
  # Enable and point at your self-hosted rerank service, e.g. Infinity:
  # http://127.0.0.1:7997/rerank
  endpoint: ""
  model: your-reranker-model
  api_key_env: FLEETENT_KB_RERANK_API_KEY

chunking:
  chunk_size: 1000
  chunk_overlap: 200
