service:
  tenant_id: default
  service_key_ref: env:FLEETENT_KB_SERVICE_KEY
  host: 127.0.0.1
  port: 8768

data:
  home: ./data

retrieval:
  default_mode: hybrid
  top_k: 10

embedding:
  endpoint: http://127.0.0.1:11434/v1/embeddings
  model: bge-small
  dimensions: 384
  api_key_env: FLEETENT_KB_EMBEDDING_API_KEY

extraction:
  enabled: false
  endpoint: http://127.0.0.1:11434/v1/
  model: qwen3:8b
  api_key_env: FLEETENT_KB_EXTRACTION_API_KEY

rerank:
  backend: disabled
  # Enable and point at your self-hosted rerank service, e.g. Infinity:
  # http://127.0.0.1:7997/rerank
  endpoint: ""
  model: your-reranker-model
  api_key_env: FLEETENT_KB_RERANK_API_KEY

chunking:
  chunk_size: 1000
  chunk_overlap: 200

connectors:
  - id: drive-shared
    type: google_drive
    enabled: false
    kb_id: kb-a
    folder_id: folder-123
    recursive: true
    access_token_env: FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN
    refresh_token_env: FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN
    client_id_env: FLEETENT_GOOGLE_DRIVE_CLIENT_ID
    client_secret_env: FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET
    token_uri_env: FLEETENT_GOOGLE_DRIVE_TOKEN_URI
    sync_interval_seconds: 1800
  - id: confluence-shared
    type: confluence
    enabled: false
    kb_id: kb-a
    base_url: https://example.atlassian.net/wiki
    username_env: FLEETENT_CONFLUENCE_USERNAME
    api_token_env: FLEETENT_CONFLUENCE_TOKEN
    space_key: ENG
    include_children: true
    sync_interval_seconds: 3600
