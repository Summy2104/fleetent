# Copy this file to $FLEETENT_HOME/kb-worker/.env on the host running `fleetent kb-worker`.
# Set file permissions to 0600 because it may contain worker access credentials.
# FLEETENT_HOME must be provided by the process environment; do not set it in this file.
# Connector source/parameter/credential config does not belong here; the control plane sends it per job.

# Queue connection used by the worker to claim and update kb_ingest_jobs.
# Dev example: sqlite:///$(FLEETENT_HOME)/management.db
FLEETENT_KB_WORKER_QUEUE_DATABASE_URL=

# Data substrate connection for KB writes; backend-specific semantics are decided by the substrate layer.
# Dev example: sqlite:///$(FLEETENT_HOME)/tenants/default/kb-substrate.db
FLEETENT_KB_WORKER_SUBSTRATE_DATABASE_URL=

# Embedder connection used by ingest-time vectorization.
FLEETENT_KB_WORKER_EMBEDDING_BACKEND=
FLEETENT_KB_WORKER_EMBEDDING_ENDPOINT=
FLEETENT_KB_WORKER_EMBEDDING_MODEL=

# Vault access used by the worker to resolve connector credential refs at runtime.
FLEETENT_KB_WORKER_VAULT_ADDR=
FLEETENT_KB_WORKER_VAULT_TOKEN=
