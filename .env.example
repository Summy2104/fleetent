# LLM providers. Leave unused providers empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# IM channels. Leave unused channels empty.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Terminal TUI (fleetent-tui) defaults — overridable via --url/--token.
FLEETENT_TUI_URL=ws://127.0.0.1:8765/ws
FLEETENT_TOKEN=

# External service credentials. Leave unused connectors empty.
FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN=
FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN=
FLEETENT_GOOGLE_DRIVE_CLIENT_ID=
FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET=
FLEETENT_CONFLUENCE_USERNAME=
FLEETENT_CONFLUENCE_TOKEN=
GITHUB_MCP_API_KEY=

# Real intelligence provider smoke. Leave unused providers empty.
FLEETENT_EVAL_REAL_EMBEDDING=0
FLEETENT_EVAL_EMBEDDING_ENDPOINT=
FLEETENT_EVAL_EMBEDDING_MODEL=
FLEETENT_EVAL_EMBEDDING_DIMENSIONS=
FLEETENT_EVAL_EMBEDDING_API_KEY=
FLEETENT_EVAL_REAL_RERANK=0
FLEETENT_EVAL_RERANK_ENDPOINT=
FLEETENT_EVAL_RERANK_MODEL=
FLEETENT_EVAL_RERANK_API_KEY=

# Deployment behavior.
FLEETENT_AUTO_UPGRADE=false
MICROSANDBOX_URL=http://host.docker.internal:7777

# Runtime defaults.
PERMISSION_GATE_MEDIUM_TIMEOUT_SECONDS=300
PERMISSION_GATE_HIGH_TIMEOUT_SECONDS=3600
CONTEXT_MAX_TOKENS=200000
CONTEXT_TMAX_RATIO=0.8
CONTEXT_TRETAINED_RATIO=0.6
CONTEXT_KEEP_RECENT=10
LOG_FORMAT=json

# Self-hosted, OpenAI-compatible vision (VLM) endpoint for the analyze_image tool.
# Empty = unconfigured (analyze_image returns an explicit failure). Cloud-hosted
# proprietary VLMs are forbidden by data sovereignty.
VISION_URL=
VISION_MODEL=default
