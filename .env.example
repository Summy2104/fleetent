# Platform (control-plane) env. Copy to the platform deploy dir as `.env`
# (docker-compose `env_file: .env`). The control-plane server runs agent-free; it
# manages/authoring agents but does not run them. Never commit real secrets.

# Platform server process env only. Agent/runtime credentials do not belong here.
# Required when the platform stores injected Agent secrets.
FLEETENT_SECRET_KEY=
# Optional DB override; default derives from FLEETENT_HOME/management.db.
DATABASE_URL=
LOG_FORMAT=

# Optional OIDC web-login client secret referenced by platform.yaml `oidc.client_secret_env`.
FLEETENT_OIDC_CLIENT_SECRET=

# Shared service key referenced by platform.yaml `kb_serve.service_key_ref`.
# Must hold the SAME value kb-serve reads as FLEETENT_KB_SERVICE_KEY from
# ${FLEETENT_HOME}/.env (the file next to kb-service.yaml) — one key, two files.
FLEETENT_PLATFORM_KB_SERVICE_KEY=

# Embedded Knowledge connector credentials. Keep values local; platform.yaml only
# references these env-var names.
FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN=
FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN=
FLEETENT_GOOGLE_DRIVE_CLIENT_ID=
FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET=
FLEETENT_GOOGLE_DRIVE_TOKEN_URI=
FLEETENT_CONFLUENCE_USERNAME=
FLEETENT_CONFLUENCE_TOKEN=

# Terminal TUI (`fleetent chat`) client defaults — overridable via --url/--token.
FLEETENT_TUI_URL=
FLEETENT_TOKEN=
