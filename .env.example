# Required
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Slack (leave empty if not using Slack)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Telegram (leave empty if not using Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional overrides (defaults shown)
MICROSANDBOX_URL=http://host.docker.internal:7777
PERMISSION_GATE_MEDIUM_TIMEOUT_SECONDS=300
PERMISSION_GATE_HIGH_TIMEOUT_SECONDS=3600
CONTEXT_MAX_TOKENS=200000
CONTEXT_TMAX_RATIO=0.8
CONTEXT_TRETAINED_RATIO=0.6
CONTEXT_KEEP_RECENT=10
LOG_FORMAT=json

# Self-hosted, OpenAI-compatible vision (VLM) endpoint for the analyze_image tool.
# Empty = unconfigured (analyze_image returns an explicit failure). Cloud-hosted
# proprietary VLMs are forbidden by data sovereignty.
VISION_URL=
VISION_MODEL=default
