# Platform (control-plane) env. Copy to the platform deploy dir as `.env`
# (docker-compose `env_file: .env`). The control-plane server runs agent-free; it
# manages/authoring agents but does not run them. Never commit real secrets.

# Deployment behavior.
FLEETENT_AUTO_UPGRADE=
# Required when the platform stores injected Agent secrets.
FLEETENT_SECRET_KEY=
# Optional DB override; default derives from FLEETENT_HOME/data.
DATABASE_URL=

# Terminal TUI (fleetent-tui) defaults — overridable via --url/--token.
FLEETENT_TUI_URL=
FLEETENT_TOKEN=

LOG_FORMAT=
