# Optional overrides — values here are the defaults
# All can be overridden via environment variables
log_format: console  # "console" | "json"
microsandbox_url: http://host.docker.internal:7777
permission_gate_medium_timeout_seconds: 300
permission_gate_high_timeout_seconds: 3600

# Sandbox / code-execution governance (SB3 owns this section skeleton; SB2 adds
# scope/idle_hours, SB4 adds resources). Three-state code-execution control:
#   off       — no agent's tool schema includes run_code (AI never sees it)
#   selective — only agents with features.code_execution: true see run_code
#   all       — every agent sees run_code unless it sets code_execution: false
# Docker being unavailable at startup degrades the effective mode to off
# (surfaced in the startup log and GET /health as "off (docker unavailable)").
# NOTE: quote "off" so YAML keeps it a string rather than the boolean false.
sandbox:
  mode: all  # off | selective | all
  # Container lifecycle (SB2). scope sets the container granularity / reuse
  # boundary; idle_hours is the agent-scope idle TTL before sweep_idle reclaims.
  #   session — one container per session, reused within it, destroyed on release
  #   agent   — one container per agent, reused across sessions, deps committed
  #             then destroyed once idle past idle_hours
  scope: session       # session (default) | agent
  idle_hours: 2        # > 0; agent-scope idle TTL in hours
  # Per-container resource limits (SB4). All optional; omitted fields use the
  # safe defaults shown below. Invalid values log a warning and fall back to the
  # default; exec_timeout is clamped to [1, 600].
  resources:
    memory: 256        # MB, > 0
    cpus: 0.5          # fractional CPUs, > 0
    network: "none"    # none (default, recommended) | public_only | allow_all
    exec_timeout: 30   # seconds; carried for wave-3 termination (not enforced yet)
    read_only: true    # session containers read-only; SB2 sets false for agent scope
  # Agent-scope tier override (SB2 consumes; applied atop `resources`). agent
  # containers always run with a writable rootfs (read_only forced false) so deps
  # land in the rootfs for `docker commit` to capture; loosen network here as
  # needed to install them. Only memory/cpus/network are honoured as overrides.
  agent_scope:
    network: "none"    # widen (e.g. allow_all) only if agents must fetch deps
    memory: 256        # MB, > 0
    cpus: 0.5          # fractional CPUs, > 0
# Max leading user messages kept whole as initial intent during compression (AR13).
compression_initial_intent_max: 2
# Coarse loop detection (AR4): repeats of one tool (same args, or same successful
# result) within the detection window before a hit. First hit warns the model;
# a repeat after that force-stops with loop_detected. The window is derived from
# this value and is not separately configurable.
agent_loop_repeat_threshold: 3
# Optional escape hatch: argument keys stripped before the signal-A fingerprint
# (e.g. a volatile timestamp). Empty by default.
loop_detect_ignore_arg_keys: []
# Two-dimensional iteration budget (AR2). The step dimension reuses
# agent_max_turns (default 50). The token dimension is unlimited (-1) by
# default, so deployments stay a pure step budget until configured. On exhaustion
# of any dimension the loop terminates with budget_exceeded after a Grace Call.
agent_max_tokens: -1        # total prompt+completion tokens across the run; -1 = unlimited
# Grace Call: a final summarizing LLM call on budget exhaustion. Its token cap is
# max(round(agent_max_tokens * ratio), min_tokens); the floor guards tiny budgets.
agent_grace_call_token_ratio: 0.05
agent_grace_call_min_tokens: 512
