# Process-level agent runtime env. Copy to the agent home as `.env`
# (FLEETENT_HOME/.env, or FLEETENT_HOME/<id>/.env for `fleetent agent run <id>`).
#
# This template holds ONLY the cross-agent, process-level variables that agent.yaml
# does NOT reference by `*_env`. The agent's own secrets (model / Slack / MCP / KB
# credentials) are materialized per-agent: the platform writes a tailored `.env`
# scaffold next to the generated agent.yaml, and the admin console's "Required
# secrets" panel lists exactly which names to fill (or injects them encrypted).
# Never commit real secrets.

# Master key for the platform secret store (inject-mode credential values are
# encrypted at rest with this). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only if any credential slot uses platform-injected mode; operator-filled
# slots do not need it.
FLEETENT_SECRET_KEY=

# Main SQLite database (platform authoring store).
DATABASE_URL=

# Sandbox (run_code) host + self-hosted vision (analyze_image) endpoint.
MICROSANDBOX_URL=http://host.docker.internal:7777
VISION_URL=
VISION_MODEL=default

# Runtime tuning.
PERMISSION_GATE_MEDIUM_TIMEOUT_SECONDS=300
PERMISSION_GATE_HIGH_TIMEOUT_SECONDS=3600
CONTEXT_MAX_TOKENS=200000
CONTEXT_TMAX_RATIO=0.8
CONTEXT_TRETAINED_RATIO=0.6
CONTEXT_KEEP_RECENT=10
LOG_FORMAT=json
