# Agent runtime env. Copy to the agent home as `.env` (FLEETENT_HOME/.env, or
# FLEETENT_HOME/<id>/.env for `fleetent agent run <id>`). Values are loaded from the
# process working directory's .env (Settings env_file). Never commit real secrets.

# LLM providers (ANTHROPIC_API_KEY is also required by the platform — listed in both).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# This agent's IM connector tokens (names referenced by agent.yaml `connectors`).
SUPPORT_SLACK_BOT=
SUPPORT_SLACK_APP=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# This agent's MCP server credentials (names referenced by agent.yaml `mcp_servers`).
ACME_DOCS_MCP_TOKEN=
BILLING_DB_DSN=
GITHUB_MCP_API_KEY=

# This agent's Knowledge Base connector credentials.
FLEETENT_GOOGLE_DRIVE_ACCESS_TOKEN=
FLEETENT_GOOGLE_DRIVE_REFRESH_TOKEN=
FLEETENT_GOOGLE_DRIVE_CLIENT_ID=
FLEETENT_GOOGLE_DRIVE_CLIENT_SECRET=
FLEETENT_CONFLUENCE_USERNAME=
FLEETENT_CONFLUENCE_TOKEN=

# Embedding / rerank providers (when backend: http).
FLEETENT_EVAL_REAL_EMBEDDING=0
FLEETENT_EVAL_EMBEDDING_ENDPOINT=
FLEETENT_EVAL_EMBEDDING_MODEL=
FLEETENT_EVAL_EMBEDDING_DIMENSIONS=
FLEETENT_EVAL_EMBEDDING_API_KEY=
FLEETENT_EVAL_REAL_RERANK=0
FLEETENT_EVAL_RERANK_ENDPOINT=
FLEETENT_EVAL_RERANK_MODEL=
FLEETENT_EVAL_RERANK_API_KEY=

# Sandbox (run_code) host + self-hosted vision (analyze_image) endpoint.
MICROSANDBOX_URL=http://host.docker.internal:7777
VISION_URL=
VISION_MODEL=default

# Runtime tuning.
PERMISSION_GATE_MEDIUM_TIMEOUT_SECONDS=300
PERMISSION_GATE_HIGH_TIMEOUT_SECONDS=3600
CONTEXT_MAX_TOKENS=200000
CONTEXT_TMAX_RATIO=0.8
CONTEXT_TRETAINED_RATIO=0.6
CONTEXT_KEEP_RECENT=10
LOG_FORMAT=json
