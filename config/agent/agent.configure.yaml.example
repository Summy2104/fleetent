# Agent 配置模板 — 仅列出「需要明确配置」的字段。
#
# 使用方式：复制本文件到 agent home，重命名为 agent.yaml，按需填写。
#   cp config/agent/agent.configure.yaml.example \
#      $FLEETENT_HOME/agents/<agent-id>/agent.yaml
#
# 不在本文件中的字段均有内置默认值，无需填写即可正常运行。
# 完整字段参考：config/agent/agent.yaml.example
# 治理/调优默认值参考：config/agent/agent.defaults.yaml.example

# ── 必填 ──────────────────────────────────────────────────────────────────────
name: ""                           # agent 名称（单 agent 模式下可任意值）
version: 1                         # 版本号，每次发布递增
system_prompt: |
  # 在此写 agent 的角色、行为规范和约束

# ── 模型（必填）──────────────────────────────────────────────────────────────
# 至少声明一个 target 并在 routes.default 中引用它。
# api_key_env 填环境变量名（值写在 .env，不要内联密钥）。
models:
  targets:
    - id: primary
      provider: anthropic           # anthropic | openai | local | …
      protocol: openai_chat
      base_url: https://api.anthropic.com/v1/
      model: claude-sonnet-4-6
      api_key_env: FLEETENT_MODEL_PRIMARY_API_KEY
      max_tokens: 4096
  routes:
    default:
      - target: primary

# ── 身份（选填，有默认值但通常需要改）────────────────────────────────────────
tenant_id: default                 # 租户 ID；多租户部署时必填
team_id:                           # 团队 ID；null = 不绑定团队

# ── 技能与工具 ────────────────────────────────────────────────────────────────
memory_namespace: ""               # 记忆隔离命名空间；默认 "" = 使用 agent name
skills_dir: skills                 # skill 目录；null = 全局默认
allowed_skills: []                 # 限定可见 skill；空 = 不限制（全部可见）
allowed_tools:                     # fnmatch 白名单；空 = 不开放任何工具
  - "read_skill"
  # - "search_*"
  # - "<mcp-server-id>__*"
plugins: []                        # 外部插件包名列表
features: {}                       # 功能开关，例如：
  # code_execution: true           # 开启 run_code 沙箱工具
  # sandbox_env:
  #   TZ: Asia/Shanghai

# ── MCP 服务器（有则填）──────────────────────────────────────────────────────
# 每个 MCP server 单独声明；工具名格式为 <id>__<tool>。
mcp_servers: []
# mcp_servers:
#   - id: my-server
#     transport: http               # http | stdio
#     url: https://my.internal/mcp
#     auth_type: bearer             # none | bearer
#     api_key_env: MY_SERVER_TOKEN  # env-var NAME，值写在 .env

# ── IM 连接器（接入 Slack 则必填）────────────────────────────────────────────
# 每个 agent 独立一个 Slack App（独立 bot identity + Socket Mode 连接）。
# *_env 填 .env 中的变量名，不要内联 token。
connectors:
  slack:
    bot_token_env: ""              # xoxb- Bot Token 对应的 env 变量名
    app_token_env: ""              # xapp- App-Level Token 对应的 env 变量名
    channels: []                   # 频道过滤；空 = 响应 bot 所在全部频道

# ── 路由绑定 ──────────────────────────────────────────────────────────────────
# 指定这个 agent 服务哪些频道和用户（格式：<platform>:<id>）。
bindings:
  channels: []                     # e.g. ["slack:C0123ABCD", "telegram:-100999"]
  users: []                        # e.g. ["u_alice", "u_bob"]

# ── 访问控制 ──────────────────────────────────────────────────────────────────
# 默认关闭：无规则时拒绝所有访问。
# allow_channels 为空 = 允许 bindings.channels 中的全部频道。
access:
  allow_channels: []
  allow_users: []
  require_approval: true           # 中/高风险操作是否需要人工审批

# ── 向量 / 嵌入 / 重排（使用知识库或语义检索时填）────────────────────────────
# 不使用语义功能时可完整省略这三个块。

# vector_store:
#   backend: sqlite                # memory（不持久化）| sqlite
#   database_url: sqlite:///data/vector_store.db

# embedding:
#   backend: http                  # deterministic（默认，无需 HTTP）| http
#   endpoint_env: FLEETENT_EMBED_ENDPOINT
#   model_env: FLEETENT_EMBED_MODEL
#   api_key_env: FLEETENT_EMBED_API_KEY
#   dimensions: 1536

# rerank:
#   backend: http                  # disabled（默认）| http
#   endpoint_env: FLEETENT_RERANK_ENDPOINT
#   model_env: FLEETENT_RERANK_MODEL
#   api_key_env: FLEETENT_RERANK_API_KEY

# ── 知识库绑定（使用知识库时填）──────────────────────────────────────────────
# knowledge.enabled 默认 false；启用后必须声明至少一个 binding。

# knowledge:
#   enabled: true
#   bindings:
#     - tenant_id: default
#       kb_id: my-kb
#       default: true
#       permissions:
#         search: true
#   retrieval_policy:
#     mode: hybrid                 # vector | keyword | hybrid
#     top_k: 10
#     rerank: true                 # 需配合 rerank.backend: http
#     embedding_route: embedding
#     rerank_route: rerank

# ── 长期上下文（使用记忆或知识库注入时填）───────────────────────────────────
# 不配置时使用全局默认值（max_tokens=2048）。

# long_term_ctx:
#   max_tokens: 2048
#   memory_max_tokens: 1024
#   knowledge_max_tokens: 1024
#   memory_top_k: 10
#   knowledge_top_k: 10
#   conflict_preference: auto      # auto | memory | knowledge

# ── 沙箱 / 视觉端点（使用相关功能时填）──────────────────────────────────────
# 默认为空（功能禁用）。填入自托管端点地址后对应工具自动可用。

# microsandbox_url: http://host.docker.internal:7777   # run_code 沙箱
# image_gen_url: ""                                    # 图像生成
# vision_url: ""                                       # 视觉分析

# ── 日志格式 ─────────────────────────────────────────────────────────────────
# 生产部署通常改为 json；本地开发保持 console。
# log_format: console              # console | json
