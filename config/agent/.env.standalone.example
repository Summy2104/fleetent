# Agent runtime env — standalone (no-platform) deployment.
#
# WHO USES THIS FILE
#   Operators who run `fleetent agent run <id>` directly without the platform
#   control-plane.
#
# AUTO-LOAD BEHAVIOUR
#   `boot()` automatically calls load_dotenv(<home>/.env, override=False) before
#   scanning agent.yaml. Copy this file to the agent home as `.env` and fill in
#   values — the process will load it at startup with no extra steps:
#
#     cp config/agent/.env.standalone.example \
#        $FLEETENT_HOME/agents/<id>/.env
#     # edit the file, then:
#     fleetent agent run <id>
#
# PRECEDENCE — override=False means external injection always wins:
#   systemd EnvironmentFile / Docker --env-file / shell export
#     take precedence over values in this file.
#   Use those mechanisms for production; this file is the fallback / local-dev layer.
#
#   Option A — systemd (production):
#     [Service]
#     EnvironmentFile=/opt/fleetent/agents/<id>/.env
#
#   Option B — Docker (production):
#     docker run --env-file $FLEETENT_HOME/agents/<id>/.env …
#
# HOW TO READ THIS FILE
#   Every KEY= below corresponds to an `*_env` reference in agent.yaml.
#   If your agent.yaml does not reference a particular key, omit it entirely.
#   The runtime only reads values whose names appear in agent.yaml *_env fields.
#
#   Fields that are set directly in agent.yaml (microsandbox_url, vision_url,
#   vision_model, log_format, etc.) are NOT read from env — set them in the
#   yaml, not here.

# ── PATH OVERRIDES ────────────────────────────────────────────────────────────
# No secrets. Set only when you need a non-default directory layout.
# Read via os.environ in: paths.py, agent_config.py, skills/registry.py,
#                         tools/plugin_loader.py

FLEETENT_HOME=           # override base dir (config+data root); default: repo root or ~/.fleetent
FLEETENT_AGENTS_DIR=     # override agents root; default: $FLEETENT_HOME/agents
FLEETENT_SKILLS_DIR=     # override skills dir; default: ./skills
FLEETENT_PLUGINS_DIR=    # override plugins dir; default: ./plugins

# ── MODEL API KEYS ────────────────────────────────────────────────────────────
# One var per `api_key_env` value in agent.yaml models.targets[*].
# Name must exactly match what you wrote in agent.yaml.
# Read via: model/resolver.py → os.environ.get(target.api_key_env)

FLEETENT_MODEL_PRIMARY_API_KEY=
FLEETENT_MODEL_FAST_API_KEY=
FLEETENT_MODEL_EMBEDDING_API_KEY=   # omit if embedding target has no api_key_env
FLEETENT_MODEL_RERANK_API_KEY=      # omit if rerank target has no api_key_env

# ── EMBEDDING SERVICE ─────────────────────────────────────────────────────────
# Filled only when agent.yaml embedding block uses *_env fields.
# If values are static, set them directly in agent.yaml instead of using *_env.
# Read via: intelligence/vector_store/embeddings.py → os.environ.get(env_name)

FLEETENT_EMBED_API_KEY=       # embedding.api_key_env
FLEETENT_EMBED_ENDPOINT=      # embedding.endpoint_env
FLEETENT_EMBED_MODEL=         # embedding.model_env
FLEETENT_EMBED_DIMENSIONS=    # embedding.dimensions_env

# ── RERANK SERVICE ────────────────────────────────────────────────────────────
# Read via: intelligence/vector_store/rerank.py → os.environ.get(env_name)

FLEETENT_RERANK_API_KEY=      # rerank.api_key_env
FLEETENT_RERANK_ENDPOINT=     # rerank.endpoint_env
FLEETENT_RERANK_MODEL=        # rerank.model_env

# ── SLACK CONNECTOR ───────────────────────────────────────────────────────────
# Names must match connectors.slack.bot_token_env / app_token_env in agent.yaml.
# Read via: im_gateway/slack_supervisor.py → os.environ.get(connector.*_token_env)

SUPPORT_SLACK_BOT=    # xoxb- Bot Token
SUPPORT_SLACK_APP=    # xapp- App-Level Token (Socket Mode)

# ── MCP SERVERS ───────────────────────────────────────────────────────────────
# One var per mcp_servers[*].api_key_env in agent.yaml.
# For stdio servers, vars listed in mcp_servers[*].env dict are passed literally
# to the subprocess environment (not resolved as env-var references).
# Read via: integrations/mcp/client.py → os.environ.get(server.api_key_env)

ACME_DOCS_MCP_TOKEN=    # mcp_servers[id=docs].api_key_env
BILLING_DB_DSN=         # referenced by subprocess via mcp_servers[id=billing].env

# ── KNOWLEDGE BASE — GOOGLE DRIVE ─────────────────────────────────────────────
# Filled only when agent.yaml has knowledge bindings with google_drive connectors.
# Names must match *_env fields in the connector definition.
# Read via: intelligence/knowledge_base/operations.py → os.getenv(config.*_env)

AGENT_GD_ACCESS_TOKEN=     # google_drive.connectors[*].access_token_env
AGENT_GD_REFRESH_TOKEN=    # google_drive.connectors[*].refresh_token_env
AGENT_GD_CLIENT_ID=        # google_drive.connectors[*].client_id_env
AGENT_GD_CLIENT_SECRET=    # google_drive.connectors[*].client_secret_env
AGENT_GD_TOKEN_URI=        # google_drive.connectors[*].token_uri_env (optional)

# ── KNOWLEDGE BASE — CONFLUENCE ───────────────────────────────────────────────
# Read via: intelligence/knowledge_base/connectors/confluence.py → os.getenv(env_name)

AGENT_CONF_USERNAME=    # confluence.connectors[*].username_env
AGENT_CONF_TOKEN=       # confluence.connectors[*].api_token_env
